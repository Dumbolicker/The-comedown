#!/usr/bin/env bash
# Prints the link to this codespace's desktop and opens it in your browser. --print only prints.
if [ -n "${CODESPACE_NAME:-}" ]; then
  url="https://${CODESPACE_NAME}-6080.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}/vnc.html?autoconnect=true&resize=scale&reconnect=true"
else
  url="http://localhost:6080/vnc.html?autoconnect=true&resize=scale&reconnect=true"
fi
cat <<EOF

  Borrowed Time desktop (Unity Hub is waiting on it):
  $url

  1. Open that link. It's private to your GitHub account. (Or: Ports tab, "Desktop", the globe icon.)
  2. In Unity Hub: read Unity's terms and click Agree, then Sign in. Firefox opens on the desktop for it;
     when Firefox asks to open Unity Hub, say yes.
  3. Add the free Personal license (Hub offers it after you sign in; or Preferences > Licenses > Add).
  4. Back here, run:  bt-license-to-github     (puts the license into GitHub's secrets and starts the Unity build)

  Desktop menu: the button at the bottom left, or right-click the desktop.
  Steps and limits: .devcontainer/README.md

EOF
if [ "${1:-}" != "--print" ] && [ -n "${BROWSER:-}" ]; then "$BROWSER" "$url" >/dev/null 2>&1 || true; fi
