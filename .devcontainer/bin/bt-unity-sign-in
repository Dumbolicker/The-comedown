#!/usr/bin/env bash
# Signs the Unity CLI in to your Unity account, with Unity's sign-in page in Firefox on this codespace's desktop.
#
# The CLI also prints a sign-in link, which you can open on any device instead; it waits until you finish. This
# script adds what a codespace needs: the desktop's display for Firefox, and its keyring (unlocked) for the CLI to
# save the sign-in in. Open the desktop tab to sign in there (bt-desktop prints its link).
# Arguments go to `unity auth login`.
set -euo pipefail
export DISPLAY="${DISPLAY:-:1}" DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-autolaunch:}"
unset BROWSER
# The CLI keeps the sign-in in the desktop's keyring; this unlocks it (or creates it) with an empty password.
printf '' | gnome-keyring-daemon --unlock --components=secrets >/dev/null 2>&1 || true
echo "Unity's sign-in page is opening in Firefox on the desktop. Finish it there (bt-desktop prints the desktop link)."
exec unity auth login "$@"
