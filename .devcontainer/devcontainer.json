// A free computer in your browser (GitHub Codespaces) for Borrowed Time: a Linux desktop you open in a browser tab,
// with Unity Hub (sign in, get the free Personal license) and Firefox, plus the repository and its tools.
// Steps for people: .devcontainer/README.md. Checked on GitHub's machines by .github/workflows/codespace-check.yml.
{
  "name": "Borrowed Time: desktop in your browser",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.13-jammy@sha256:d6ce9cdf043d4ec162cf6e9671232a65e3ad22a339175a1cd4936a3ae67f8433",
  "features": {
    // Fluxbox desktop + TigerVNC + noVNC (the desktop in a browser tab on port 6080). The VNC server only listens inside
    // the codespace; GitHub's private port forwarding is what keeps the desktop yours, so it needs no second password.
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": { "password": "noPassword", "noVncVersion": "1.6.0" },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x800x24"
  },
  "runArgs": ["--shm-size=1g"],
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/bin/bt-desktop --print",
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
