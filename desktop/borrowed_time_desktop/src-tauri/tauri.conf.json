{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borrowed Time",
  "version": "0.4.0",
  "identifier": "games.borrowedtime.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Borrowed Time", "width": 1280, "height": 720, "minWidth": 800, "minHeight": 450, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
